# ==============================================================================
# Single-Project Topology Environment Variables
# All infrastructure, GKE workload, and Gemini Enterprise reside in a single GCP project.
# Copy this file to .env:
#   cp .env.single-project.example .env
# Then load variables:
#   set -a && source .env && set +a
# ==============================================================================

# --- REQUIRED VARIABLES ---
PROJECT_ID="your-project-id"                                   # GCP Project hosting GKE, ALB & Gemini Enterprise
PROJECT_NUM="your-project-number"                               # Numeric Project Number (required for Discovery Engine REST APIs)
DOMAIN_NAME="hello-world-a2a.yourdomain.com"                   # Fully qualified domain name pointing to Regional Internal ALB VIP
DNS_ZONE_NAME="your-dns-zone-name"                             # Cloud DNS managed zone name (for A record & DNS-01 cert challenge)
ENGINE_ID="your-gemini-enterprise-app-id"                      # Discovery Engine App/Engine ID

# --- OPTIONAL / DEFAULTED VARIABLES ---
DNS_PROJECT_ID="${PROJECT_ID}"                                 # Project hosting Cloud DNS zone (defaults to PROJECT_ID)
GKE_REGION="us-central1"                                        # Workload & ALB region (must match GATEWAY_REGION)
GATEWAY_REGION="us-central1"                                   # Egress Agent Gateway region (must match GKE_REGION)
GATEWAY_NAME="hello-world-a2a-egress-gateway"                  # Egress Agent Gateway resource name
ALB_INTERNAL_IP="10.0.0.10"                                    # Reserved private RFC 1918 VIP for ALB
PROJECT_NAME="hello-world-a2a"                                 # Common resource naming prefix
IMAGE_TAG="v1"                                                 # Container image tag for Cloud Build & GKE deployment
