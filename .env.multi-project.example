# ==============================================================================
# Multi-Project Topology Environment Variables
# Separates Workload Project (GKE/ALB/VPC) from Consumer Project (Gemini Enterprise/Gateway).
# Copy this file to .env:
#   cp .env.multi-project.example .env
# Then load variables:
#   set -a && source .env && set +a
# ==============================================================================

# --- REQUIRED VARIABLES ---
WORKLOAD_PROJECT_ID="your-workload-project-id"                 # Project A: Hosts GKE, VPC, ALB, Certs, PSC Attachment
CONSUMER_PROJECT_ID="your-consumer-project-id"                 # Project B: Hosts GE App, Agent Gateway, Catalog
CONSUMER_PROJECT_NUM="your-consumer-project-num"               # Project B Number (required for Discovery Engine REST APIs)
DOMAIN_NAME="hello-world-a2a.yourdomain.com"                   # Fully qualified domain name pointing to Regional Internal ALB VIP
DNS_ZONE_NAME="your-dns-zone-name"                             # Cloud DNS managed zone name (for A record & DNS-01 cert challenge)
DNS_PROJECT_ID="your-consumer-project-id"                      # Project hosting Cloud DNS zone (typically Project B)
ENGINE_ID="your-gemini-enterprise-app-id"                      # Discovery Engine App/Engine ID in Project B

# --- OPTIONAL / DEFAULTED VARIABLES ---
GKE_REGION="us-central1"                                        # Workload & ALB region in Project A (must match GATEWAY_REGION)
GATEWAY_REGION="us-central1"                                   # Gateway region in Project B (must match GKE_REGION for PSC data plane)
GATEWAY_NAME="hello-world-a2a-egress-gateway"                  # Egress Agent Gateway resource name in Project B
ALB_INTERNAL_IP="10.0.0.6"                                     # Reserved private RFC 1918 VIP for ALB in Project A
PROJECT_NAME="hello-world-a2a"                                 # Common resource naming prefix
IMAGE_TAG="v1"                                                 # Container image tag for Cloud Build & GKE deployment
