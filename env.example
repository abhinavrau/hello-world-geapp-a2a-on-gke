# ==============================================================================
# Environment Configuration Template for Hello World A2A on GKE
# Copy this file to .env and replace the placeholder values with your own.
# ==============================================================================

# Google Cloud Project Configuration (Single Project Mode)
PROJECT_ID="your-project-id"
PROJECT_NUM="your-project-number"

# Multi-Project Configuration (Optional: Use when separating Workload and Consumer projects)
WORKLOAD_PROJECT_ID="your-workload-project-id"     # Project A: GKE, VPC, ILB, Certs, PSC Attachment
WORKLOAD_PROJECT_NUM="your-workload-project-num"
CONSUMER_PROJECT_ID="your-consumer-project-id"     # Project B: Gemini Enterprise App, Agent Gateway, Agent Registry
CONSUMER_PROJECT_NUM="your-consumer-project-num"
DNS_PROJECT_ID="your-dns-project-id"               # Project hosting Cloud DNS zone (optional, defaults to CONSUMER_PROJECT_ID)

# Regional Infrastructure Configuration
GKE_REGION="us-central1"                  # Region where GKE and Internal ALB reside
GATEWAY_REGION="us-central1"           # Region where Gemini Enterprise Agent Gateway resides
GATEWAY_NAME="hello-world-a2a-egress-gateway" # Name of the Agent Gateway

# Networking & DNS Configuration
DOMAIN_NAME="hello-world-a2a.example.com" # Fully Qualified Domain Name for A2A Service
DNS_ZONE_NAME="my-cloud-dns-zone"        # Cloud DNS Managed Zone Name
ALB_INTERNAL_IP="10.0.0.10"              # Reserved Private VIP for Regional Internal ALB

# Gemini Enterprise Application Configuration
ENGINE_ID="your-gemini-enterprise-app-id" # Discovery Engine App/Engine ID

# Application & Container Deployment Configuration
PROJECT_NAME="hello-world-a2a"           # Base name for Kubernetes & GCP resources
IMAGE_TAG="v1"                           # Docker image version tag
IMAGE_URI="${GKE_REGION}-docker.pkg.dev/${PROJECT_ID}/${PROJECT_NAME}/${PROJECT_NAME}:${IMAGE_TAG}"

